      "code": "\nimport pandas as pd, numpy as np\n\nTARGET_LINE = 2\nGAIN = 11.5\nSCALE = 3.8\nAMPLITUDE = 2.0\nNOISE_BASE = 0.65\nNOISE_HIGH_SLOPE = 0.22\nINITIAL_REGION_MAX = 6.0\nACTIVATION_END = 10.0\nPOST_MAINTAIN = 1.4169597464560225e-12\nPOST_REVISE = 0.9999999999985831\nPOST_DOUBT = 1.9133783855484439e-25\n\ndef _phi(driver):\n    driver = np.asarray(driver, dtype=float)\n    t = (driver - INITIAL_REGION_MAX) / (ACTIVATION_END - INITIAL_REGION_MAX)\n    return np.where(driver <= INITIAL_REGION_MAX, 0.0,\n                    np.where(driver >= ACTIVATION_END, 1.0, t * t * (3.0 - 2.0 * t)))\n\ndef _base_mean(driver):\n    driver = np.asarray(driver, dtype=float)\n    return 10.0 + GAIN * (1.0 - np.exp(-driver / SCALE))\n\ndef _base_sd(driver):\n    driver = np.asarray(driver, dtype=float)\n    return NOISE_BASE + NOISE_HIGH_SLOPE * np.maximum(driver - 5.0, 0.0)\n\ndef model(regime, n, seed):\n    rng = np.random.default_rng(seed)\n    driver = float(regime.config.get(\"driver\", 0.0))\n    line = int(regime.config.get(\"line\", 0))\n    mu = np.repeat(_base_mean(driver), int(n)).astype(float)\n    sd = np.repeat(_base_sd(driver), int(n)).astype(float)\n\n    if line == TARGET_LINE:\n        probs = np.array([POST_MAINTAIN, POST_REVISE, POST_DOUBT], dtype=float)\n        probs = probs / probs.sum()\n        scenario = rng.choice(np.array([\"maintain\", \"revise\", \"doubt\"], dtype=object), p=probs)\n        ph = float(_phi(driver))\n        if scenario == \"revise\":\n            mu = mu - AMPLITUDE * ph\n        elif scenario == \"doubt\":\n            signs = rng.choice(np.array([-1.0, 1.0]), size=int(n))\n            mu = mu + signs * AMPLITUDE * ph\n\n    y = rng.normal(mu, sd, size=int(n))\n    return pd.DataFrame({\"outcome\": y})\n",
